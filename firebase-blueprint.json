{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public gaming profile and stats for community leaderboard and player directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "photoUrl": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "rankTitle": { "type": "string" },
        "curriculumDay": { "type": "number" },
        "currentStreak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "ayumuMaxNumbers": { "type": "number" },
        "matrixMaxLevel": { "type": "number" },
        "dualNBackMaxN": { "type": "number" },
        "fastestFlashMs": { "type": "number" },
        "detectiveHighScore": { "type": "number" },
        "lockedFlashSpeed": { "type": "number" },
        "isSpeedLockedToPlan": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username", "photoUrl", "level", "xp"]
    },
    "PrivateUserData": {
      "title": "PrivateUserData",
      "description": "Private game state and deep progress backup per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "statsJson": { "type": "string" },
        "protocolJson": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "statsJson", "protocolJson"]
    },
    "YosephMasterSave": {
      "title": "YosephMasterSave",
      "description": "Unified multi-device cognitive telemetry and daily protocol save for Yoseph across 2 phones and PC",
      "type": "object",
      "properties": {
        "statsJson": { "type": "string" },
        "protocolJson": { "type": "string" },
        "freeTrainingJson": { "type": "string" },
        "fourHourPlanJson": { "type": "string" },
        "profileJson": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastDevice": { "type": "string" }
      },
      "required": ["statsJson", "protocolJson", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public player profile allowing all users to view and compare community memory athletes"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "PrivateUserData",
      "description": "Private detailed telemetry and save state restricted strictly to the document owner"
    },
    "/yoseph_cloud_sync/{docId}": {
      "schema": "YosephMasterSave",
      "description": "Central persistent synchronization store connecting Yoseph's PC and 2 mobile phones"
    }
  }
}
